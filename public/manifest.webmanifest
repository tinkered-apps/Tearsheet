{
  "name": "Tearsheet",
  "short_name": "Tearsheet",
  "description": "Build and print an A4 property leaflet with tear-off phone tabs. Your listing and photo stay in your browser.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f5f7",
  "theme_color": "#15213b",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshots/narrow.png", "sizes": "824x1830", "type": "image/png", "form_factor": "narrow", "label": "Write the details of a sample property" },
    { "src": "screenshots/wide.png", "sizes": "2400x1350", "type": "image/png", "form_factor": "wide", "label": "Edit a listing beside its A4 leaflet preview" }
  ]
